#!/sbin/openrc-run
# Optional host-only service. Install root-owned 0755 after reviewing node UID.
name="FortisNet local sandbox broker"
command="/opt/fortis-sandboxes/fortis-sandbox"
command_args="/etc/fortis-sandbox.json broker /run/fortis-sandbox/node.sock 10001"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
respawn_period=60
umask=0077
pidfile="/run/fortis-sandbox-broker.pid"
output_log="/var/log/fortis-sandbox-broker.log"
error_log="/var/log/fortis-sandbox-broker.log"
retry="TERM/30/KILL/5"

depend() {
    need fortis-sandbox
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /run/fortis-sandbox
    "$command" /etc/fortis-sandbox.json doctor
}
