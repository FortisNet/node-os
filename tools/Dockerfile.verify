# Toolchain for this repository's own gate (verify.py): build and check tools only.
# Nothing from this image is deployed.
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
RUN apt-get update && apt-get install -y --no-install-recommends \
    bzip2 ca-certificates clang-18 clang-format-18 clang-tidy-18 cppcheck \
    gcc-13 g++-13 libc++-18-dev libc++abi-18-dev libclang-rt-18-dev make openssl perl pyflakes3 \
    python3 shellcheck \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
