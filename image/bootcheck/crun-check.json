{
 "ociVersion": "1.0.2",
 "process": {
  "terminal": false,
  "user": {
   "uid": 10001,
   "gid": 10001
  },
  "args": [
   "/bin/busybox",
   "sh",
   "-c",
   "/bin/busybox id; /bin/busybox grep -E 'CapEff|NoNewPrivs|Seccomp:' /proc/self/status; echo memory.max=$(/bin/busybox cat /sys/fs/cgroup/memory.max) pids.max=$(/bin/busybox cat /sys/fs/cgroup/pids.max); /bin/busybox unshare -U /bin/busybox true 2>&1; /bin/busybox touch /denied 2>&1"
  ],
  "env": [
   "PATH=/bin"
  ],
  "cwd": "/",
  "capabilities": {
   "bounding": [],
   "effective": [],
   "inheritable": [],
   "permitted": [],
   "ambient": []
  },
  "noNewPrivileges": true,
  "rlimits": [
   {
    "type": "RLIMIT_CORE",
    "hard": 0,
    "soft": 0
   },
   {
    "type": "RLIMIT_NOFILE",
    "hard": 65536,
    "soft": 65536
   }
  ]
 },
 "root": {
  "path": "rootfs",
  "readonly": true
 },
 "hostname": "fortis-bootcheck",
 "mounts": [
  {
   "destination": "/proc",
   "type": "proc",
   "source": "proc",
   "options": [
    "nosuid",
    "noexec",
    "nodev"
   ]
  },
  {
   "destination": "/dev",
   "type": "tmpfs",
   "source": "tmpfs",
   "options": [
    "nosuid",
    "noexec",
    "strictatime",
    "mode=755",
    "size=64k"
   ]
  },
  {
   "destination": "/tmp",
   "type": "tmpfs",
   "source": "tmpfs",
   "options": [
    "nosuid",
    "noexec",
    "nodev",
    "mode=1777",
    "size=16m"
   ]
  },
  {
   "destination": "/sys/fs/cgroup",
   "type": "cgroup",
   "source": "cgroup",
   "options": [
    "nosuid",
    "noexec",
    "nodev",
    "ro"
   ]
  }
 ],
 "linux": {
  "namespaces": [
   {
    "type": "pid"
   },
   {
    "type": "mount"
   },
   {
    "type": "ipc"
   },
   {
    "type": "uts"
   },
   {
    "type": "cgroup"
   }
  ],
  "cgroupsPath": "/fortis/fortis-bootcheck",
  "resources": {
   "memory": {
    "limit": 536870912
   },
   "pids": {
    "limit": 512
   }
  },
  "maskedPaths": [
   "/proc/acpi",
   "/proc/asound",
   "/proc/kcore",
   "/proc/keys",
   "/proc/latency_stats",
   "/proc/timer_list",
   "/proc/timer_stats",
   "/proc/sched_debug",
   "/proc/scsi",
   "/sys/firmware"
  ],
  "readonlyPaths": [
   "/proc/bus",
   "/proc/fs",
   "/proc/irq",
   "/proc/sys",
   "/proc/sysrq-trigger"
  ],
  "seccomp": {
   "defaultAction": "SCMP_ACT_ALLOW",
   "architectures": [
    "SCMP_ARCH_X86_64"
   ],
   "syscalls": [
    {
     "names": [
      "acct",
      "add_key",
      "bpf",
      "chroot",
      "clock_adjtime",
      "clock_settime",
      "clone3",
      "create_module",
      "delete_module",
      "fanotify_init",
      "finit_module",
      "fsconfig",
      "fsmount",
      "fsopen",
      "fspick",
      "get_kernel_syms",
      "init_module",
      "io_uring_enter",
      "io_uring_register",
      "io_uring_setup",
      "ioperm",
      "iopl",
      "kcmp",
      "kexec_file_load",
      "kexec_load",
      "keyctl",
      "lookup_dcookie",
      "mbind",
      "migrate_pages",
      "mount",
      "mount_setattr",
      "move_mount",
      "move_pages",
      "name_to_handle_at",
      "nfsservctl",
      "open_by_handle_at",
      "open_tree",
      "perf_event_open",
      "personality",
      "pidfd_getfd",
      "pivot_root",
      "process_madvise",
      "process_vm_readv",
      "process_vm_writev",
      "ptrace",
      "query_module",
      "quotactl",
      "reboot",
      "request_key",
      "set_mempolicy",
      "setns",
      "settimeofday",
      "swapoff",
      "swapon",
      "sysfs",
      "syslog",
      "umount2",
      "unshare",
      "userfaultfd",
      "uselib",
      "ustat",
      "vhangup"
     ],
     "action": "SCMP_ACT_ERRNO",
     "errnoRet": 1
    },
    {
     "names": [
      "clone3"
     ],
     "action": "SCMP_ACT_ERRNO",
     "errnoRet": 38
    },
    {
     "names": [
      "clone"
     ],
     "action": "SCMP_ACT_ERRNO",
     "errnoRet": 1,
     "args": [
      {
       "index": 0,
       "value": 268435456,
       "valueTwo": 268435456,
       "op": "SCMP_CMP_MASKED_EQ"
      }
     ]
    }
   ]
  }
 }
}
