# FortisNet Node OS: the orchestrator, the sandbox manager and their tests.
#
# Self-contained. It reads nothing outside this repository except the pinned
# Mbed TLS archive that tools/fetch-mbedtls.sh downloads into .deps/.
#
#   make                    build both programs into build/
#   make test               build and run every test
#   make verify             the full gate, in a container: two compilers,
#                           static analysis, lint, cppcheck and every test
#   make release VERSION=v  hardened static releases for x86_64 and aarch64
#   make BUILD=dir CXX=...  build elsewhere, or with another compiler
#
# The images are built from releases by image/build-image.sh.

BUILD ?= build
CXX ?= c++
CC ?= cc
DEFAULT_CXXFLAGS := -O2 -std=c++23 -fno-rtti -Wall -Wextra -Wpedantic -Werror -Wformat=2 -Wundef -Wcast-align -Woverloaded-virtual -Wnon-virtual-dtor -ffp-contract=off
CXXFLAGS ?= $(DEFAULT_CXXFLAGS)
# Extra C flags for the Mbed TLS build (the release build passes hardening).
DEPENDENCY_CFLAGS ?=
# What the orchestrator calls itself on its pages; a release build passes its version.
ORCHESTRATOR_VERSION ?= development

MBEDTLS_VERSION := 3.6.7
MBEDTLS_ARCHIVE := .deps/mbedtls-$(MBEDTLS_VERSION).tar.bz2
MBEDTLS := $(BUILD)/mbedtls-$(MBEDTLS_VERSION)
MBEDTLS_LIBS := $(addprefix $(MBEDTLS)/library/,libmbedtls.a libmbedx509.a libmbedcrypto.a)
MBEDTLS_DEFINES := -DMBEDTLS_THREADING_C -DMBEDTLS_THREADING_PTHREAD -DMBEDTLS_USER_CONFIG_FILE=\"fortis_mbedtls_config.h\"
# The same defines for the library's own make, which the shell and that make
# each unquote once more.
MBEDTLS_LIBRARY_DEFINES := -DMBEDTLS_THREADING_C -DMBEDTLS_THREADING_PTHREAD -DMBEDTLS_USER_CONFIG_FILE=\\\"fortis_mbedtls_config.h\\\"
# Files generated by the build: the first page's shell as bytes.
GENERATED := $(BUILD)/generated
PAGE_SHELL := $(GENERATED)/page_shell.inc
CPPFLAGS := $(MBEDTLS_DEFINES) -DFORTIS_ORCHESTRATOR_VERSION=\"$(ORCHESTRATOR_VERSION)\" -pthread -I$(MBEDTLS)/include -Ilib -Iorchestrator -Isandbox -I$(GENERATED)

ORCHESTRATOR_SOURCES := $(addprefix orchestrator/,native_update.cpp node_keeper.cpp acme_client.cpp page_server.cpp release_ledger.cpp backup.cpp release_fetch.cpp pages.cpp first_boot.cpp)
SANDBOX_SOURCES := sandbox/sandbox_spec.cpp sandbox/sandbox_manager.cpp
LIB_SOURCES := lib/bounded_json.cpp lib/outbound_https.cpp lib/sandbox_socket.cpp
TEST_SOURCES := tests/release_ledger_test.cpp tests/sandbox_spec_test.cpp
SOURCES := $(ORCHESTRATOR_SOURCES) $(SANDBOX_SOURCES) $(LIB_SOURCES) $(TEST_SOURCES)
HEADERS := $(wildcard lib/*.h orchestrator/*.h sandbox/*.h)
object = $(patsubst %.cpp,$(BUILD)/%.o,$(1))

.PHONY: all test unit-tests tool-tests clean release sandbox-runtime-test verify
.PHONY: print-sources print-flags print-default-flags print-native-controller-sources print-fortis-sandbox-sources
all: $(BUILD)/native-controller $(BUILD)/fortis-sandbox

# Objects are rebuilt when the compiler or its flags change.
FLAGS_STAMP := $(BUILD)/.flags-$(firstword $(shell printf '%s' '$(CC) | $(CXX) | $(CXXFLAGS) | $(DEPENDENCY_CFLAGS) | $(ORCHESTRATOR_VERSION)' | cksum))
$(FLAGS_STAMP):
	@mkdir -p $(BUILD)
	@rm -f $(BUILD)/.flags-*
	@touch $@

$(MBEDTLS_ARCHIVE):
	./tools/fetch-mbedtls.sh
# One recipe builds the three libraries; the stamp is what objects wait for.
$(MBEDTLS)/.built: $(MBEDTLS_ARCHIVE) lib/fortis_mbedtls_config.h tools/fetch-mbedtls.sh $(FLAGS_STAMP)
	./tools/fetch-mbedtls.sh
	rm -rf $(MBEDTLS)
	tar -xjf $(MBEDTLS_ARCHIVE) -C $(BUILD)
	$(MAKE) -C $(MBEDTLS)/library generated_files
	$(MAKE) -C $(MBEDTLS)/library -j4 static CC="$(CC)" CFLAGS="-O2 $(DEPENDENCY_CFLAGS) $(MBEDTLS_LIBRARY_DEFINES) -pthread -I$(abspath lib)"
	touch $@
$(MBEDTLS_LIBS): $(MBEDTLS)/.built

$(PAGE_SHELL): tools/embed_page.py $(wildcard assets/*)
	python3 tools/embed_page.py $@

$(call object,$(SOURCES)): $(BUILD)/%.o: %.cpp $(HEADERS) $(PAGE_SHELL) $(MBEDTLS)/.built $(FLAGS_STAMP)
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(BUILD)/native-controller: $(call object,$(ORCHESTRATOR_SOURCES) lib/bounded_json.cpp lib/outbound_https.cpp) $(MBEDTLS_LIBS)
	$(CXX) $(CXXFLAGS) $(filter %.o,$^) $(MBEDTLS_LIBS) -pthread -o $@
$(BUILD)/fortis-sandbox: $(call object,$(SANDBOX_SOURCES) lib/sandbox_socket.cpp lib/bounded_json.cpp) $(MBEDTLS_LIBS)
	$(CXX) $(CXXFLAGS) $(filter %.o,$^) $(MBEDTLS)/library/libmbedcrypto.a -pthread -o $@
$(BUILD)/release_ledger_test: $(call object,tests/release_ledger_test.cpp orchestrator/release_ledger.cpp lib/bounded_json.cpp) $(MBEDTLS_LIBS)
	$(CXX) $(CXXFLAGS) $(filter %.o,$^) $(MBEDTLS)/library/libmbedcrypto.a -pthread -o $@
$(BUILD)/sandbox_spec_test: $(call object,tests/sandbox_spec_test.cpp sandbox/sandbox_spec.cpp lib/bounded_json.cpp)
	$(CXX) $(CXXFLAGS) $(filter %.o,$^) -pthread -o $@

unit-tests: $(BUILD)/release_ledger_test $(BUILD)/sandbox_spec_test
	$(BUILD)/release_ledger_test
	$(BUILD)/sandbox_spec_test
# The update tests start the orchestrator through the same wrapper script the
# host uses; FORTIS_NATIVE_CONTROLLER points it at this build.
tool-tests: all
	python3 tools/check_lib_origin.py
	python3 image/readme_packages.py check
	FORTIS_NATIVE_CONTROLLER=$(abspath $(BUILD)/native-controller) python3 tests/native_update_test.py
	python3 tests/verify_test.py
	python3 tests/hardening_test.py
	python3 sandbox/tests/sandbox_cli_test.py $(BUILD)/fortis-sandbox
	python3 sandbox/tests/sandbox_service_test.py
	python3 sandbox/tests/gvisor_package_test.py
	shellcheck tools/fetch-mbedtls.sh tools/submit-node-release.sh image/build-bootcheck-image.sh image/build-image.sh image/fetch-node-release.sh image/test-container.sh image/files/fortis image/files/container-start.sh image/bootcheck/fortis-bootcheck.sh image/files/manage-native-node.sh image/files/run-native-service.sh image/files/fortis-native.openrc build-release.sh sign-release.sh sandbox/test-linux-sandboxes.sh
test: unit-tests tool-tests

# For the gate: what to lint and analyse, and with which flags.
print-sources:
	@printf '%s\n' $(SOURCES)
print-flags:
	@printf '%s\n' '$(CPPFLAGS) $(CXXFLAGS)'
# For the release audit: the sources each program is made of.
print-native-controller-sources:
	@printf '%s\n' $(ORCHESTRATOR_SOURCES) lib/bounded_json.cpp lib/outbound_https.cpp
print-fortis-sandbox-sources:
	@printf '%s\n' $(SANDBOX_SOURCES) lib/sandbox_socket.cpp lib/bounded_json.cpp

# The full gate. It runs in a container it builds itself; see verify.py.
verify:
	python3 verify.py
# An unsigned static release, from files that passed the gate: VERSION=...
release:
	./build-release.sh "$(VERSION)" x86_64
	./build-release.sh "$(VERSION)" aarch64
# Privileged sandbox tests under real gVisor: NODE=path/to/node (optional).
sandbox-runtime-test:
	./sandbox/test-linux-sandboxes.sh $(NODE)

print-default-flags:
	@printf '%s\n' '$(DEFAULT_CXXFLAGS)'
clean:
	rm -rf build
