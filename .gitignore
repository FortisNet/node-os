# Build, gate and release output.
/build/
/build-*/
/dist/
*.o
*.d

# The pinned Mbed TLS archive, downloaded by tools/fetch-mbedtls.sh.
/.deps/

# Keys and local settings never belong here.
*.pem
*.key
# The one exception: the public half of the release key, which images trust.
!/image/release-public.pem
.env
.env.*

# Python, editors and operating systems.
__pycache__/
*.py[cod]
.idea/
.vscode/
*.swp
*~
.DS_Store
